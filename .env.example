# =============================================================================
# DevFlow Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment:
#   cp .env.example .env

# Server
SERVER_PORT=8080
ENVIRONMENT=development    # development | production
LOG_LEVEL=debug            # debug | info | warn | error

# Database
DATABASE_URL=postgres://user:password@host:5432/devflow?sslmode=require

# Redis (Phase 8)
# REDIS_URL=redis://localhost:6379

# JWT (Phase 3)
JWT_SECRET=your-secret-key-change-this-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-change-this-min-32-chars
